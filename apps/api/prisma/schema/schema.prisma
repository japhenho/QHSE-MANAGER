// Generator and datasource only. Models live in sibling files, one per business
// domain (e.g. tenancy.prisma), all inside this directory.
// The connection URL lives in prisma.config.ts (Prisma 7), not in this file.

generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}
