// Access control domain: roles, their permissions and their assignment to users.
// Permission keys are defined in code (packages/shared), not in the database.

/// A set of permissions, usually one per job position. Created by tenant administrators.
model Role {
  id           String   @id @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  name         String
  description  String?
  /// Stable key of a role installed with the tenant ("administrator"...). NULL for
  /// roles created by the tenant.
  referenceKey String?  @map("reference_key")
  /// The administrator role: holds every permission, cannot be changed nor deleted.
  isSystem     Boolean  @default(false) @map("is_system")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  /// Optimistic concurrency control (ADR 0004).
  version      Int      @default(1)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  permissions RolePermission[]
  assignments RoleAssignment[]

  @@unique([tenantId, name])
  @@unique([tenantId, referenceKey])
  @@unique([tenantId, id])
  @@map("roles")
}

model RolePermission {
  tenantId   String @map("tenant_id") @db.Uuid
  roleId     String @map("role_id") @db.Uuid
  /// A key of the permission catalogue, e.g. "role:manage".
  permission String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  role   Role   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([roleId, permission])
  @@index([tenantId, roleId])
  @@map("role_permissions")
}

/// Where a role applies. A scope covers what it contains: a company covers its sites,
/// a site covers its departments. New kinds (project, contract) are added here together
/// with their column, when the first module that needs them is built.
enum AccessScopeType {
  TENANT
  COMPANY
  SITE
  DEPARTMENT

  @@map("access_scope_type")
}

/// A role given to a user on a scope: the whole tenant, one company, one site or one
/// department. Several assignments add up (union of scopes).
model RoleAssignment {
  id           String          @id @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  roleId       String          @map("role_id") @db.Uuid
  scopeType    AccessScopeType @default(TENANT) @map("scope_type")
  companyId    String?         @map("company_id") @db.Uuid
  siteId       String?         @map("site_id") @db.Uuid
  departmentId String?         @map("department_id") @db.Uuid
  /// "tenant", or the id of the scope entity. Makes "one assignment per user, role and
  /// scope" a plain unique constraint.
  scopeKey     String          @default("tenant") @map("scope_key")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Who granted it; NULL when granted by the provisioning command.
  assignedBy   String?         @map("assigned_by") @db.Uuid

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user       User        @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  role       Role        @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Restrict)
  /// Composite keys: the scope always belongs to the tenant of the assignment.
  company    Company?    @relation(fields: [tenantId, companyId], references: [tenantId, id], onDelete: Restrict)
  site       Site?       @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Restrict)
  department Department? @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, userId, roleId, scopeKey])
  @@index([tenantId, roleId])
  @@index([tenantId, userId])
  @@map("role_assignments")
}
