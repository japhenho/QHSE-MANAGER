{
  "name": "qhse-manager",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm build:shared && pnpm -r run lint",
    "typecheck": "pnpm build:shared && pnpm -r run typecheck",
    "test": "pnpm build:shared && pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:api": "pnpm --filter @qhse/api dev",
    "dev:web": "pnpm --filter @qhse/web dev",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "build:shared": "pnpm --filter @qhse/shared build",
    "test:e2e": "pnpm build:shared && pnpm --filter @qhse/api run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
