# Exemple de configuration — NE CONTIENT AUCUN SECRET RÉEL.
# Copier vers .env et adapter. Ne jamais commiter .env.
NODE_ENV=development

# API
API_PORT=3000
API_CORS_ORIGINS=http://localhost:5173

# PostgreSQL — valeurs de développement local uniquement, à changer partout ailleurs.
# Superutilisateur du conteneur : sert uniquement à créer les rôles et les bases.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-dev-only
POSTGRES_PORT=5432

# Deux rôles applicatifs (ADR 0002) :
#  - propriétaire : possède le schéma, exécute les migrations ; jamais utilisé par l'API ;
#  - exécution    : utilisé par l'API ; ni superutilisateur, ni propriétaire, sans BYPASSRLS, sans DDL.
DB_OWNER_USER=qhse_owner
DB_OWNER_PASSWORD=change-me-owner-dev-only
DB_APP_USER=qhse_app
DB_APP_PASSWORD=change-me-app-dev-only
DB_NAMES="qhse_dev qhse_test"
# "true" autorise le propriétaire à créer la base temporaire de `prisma migrate dev`.
# Développement et CI uniquement.
DB_OWNER_CREATEDB=true

# API (rôle d'exécution)
DATABASE_URL=postgresql://qhse_app:change-me-app-dev-only@localhost:5432/qhse_dev?schema=public
# Migrations (rôle propriétaire)
MIGRATION_DATABASE_URL=postgresql://qhse_owner:change-me-owner-dev-only@localhost:5432/qhse_dev?schema=public

# Tests d'intégration : base dédiée dont le nom se termine par "_test" (elle est vidée par les tests).
TEST_DATABASE_URL=postgresql://qhse_app:change-me-app-dev-only@localhost:5432/qhse_test?schema=public
TEST_MIGRATION_DATABASE_URL=postgresql://qhse_owner:change-me-owner-dev-only@localhost:5432/qhse_test?schema=public

# Web
VITE_API_BASE_URL=http://localhost:3000/api/v1

# API — optionnel
# Documentation OpenAPI (/api/docs). Par défaut : activée, sauf si NODE_ENV=production.
API_DOCS_ENABLED=
# Niveau de log pino (fatal|error|warn|info|debug|trace|silent). Par défaut : info.
LOG_LEVEL=
